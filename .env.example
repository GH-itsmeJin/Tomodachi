PORT=8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
FRONTEND_ORIGIN=http://localhost:3000
LITELLM_MODEL=tomodachi
